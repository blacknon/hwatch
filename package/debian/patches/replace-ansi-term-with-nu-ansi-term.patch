         Color::LightMagenta => Some(ansi_term::Colour::Fixed(13)),
         Color::LightCyan => Some(ansi_term::Colour::Fixed(14)),
         Color::White => Some(ansi_term::Colour::White),
-        Color::Rgb(r, g, b) => Some(ansi_term::Colour::RGB(r, g, b)),
